# Template for .env. Run `make env` to create .env with random secrets
# (or to add variables that are new since your .env was created).
# .env is git-ignored: no password or key may be committed (PDF §4, Securitate).
# __GENERATE__ / __GENERATE_KEY32__ are replaced by scripts/gen-env.sh.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=filegrid
# Superuser: operations only, never used by FileGrid.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
# Owns the `filegrid` schema; used by Flyway (db-migrate) only.
FILEGRID_DB_MIGRATOR_PASSWORD=__GENERATE__
# Runtime role for the backend: DML only, cannot change the schema.
FILEGRID_DB_APP_PASSWORD=__GENERATE__

# --- MinIO (S3) ---------------------------------------------------------------
MINIO_ROOT_USER=filegrid-root
MINIO_ROOT_PASSWORD=__GENERATE__
# Backend credentials, restricted to the filegrid-* buckets.
FILEGRID_S3_ACCESS_KEY=filegrid-app
FILEGRID_S3_SECRET_KEY=__GENERATE__

# --- FTP (vsftpd) -------------------------------------------------------------
FTP_USER=filegrid
FTP_PASSWORD=__GENERATE__

# --- Encryption (backend) -----------------------------------------------------
# Master key that wraps the per-file keys of encrypted files (connection documents).
# LOSING IT MAKES THOSE FILES UNREADABLE: back it up outside the repo (password manager / KMS).
FILEGRID_MASTER_KEY_V1=__GENERATE_KEY32__
# Secret for HMAC-ing CNP/CUI (lookup without storing the identifier). Do not rotate casually.
FILEGRID_IDENTITY_PEPPER=__GENERATE__
# Shared key the smart meters (simulator) send in the X-API-Key header.
FILEGRID_METER_API_KEY=__GENERATE__

# --- Keycloak (authentication) --------------------------------------------------
# Database password for Keycloak's own `keycloak` database.
KEYCLOAK_DB_PASSWORD=__GENERATE__
# Keycloak administration console (master realm), user `admin`.
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
# Seeded users of the `filegrid` realm (created on first start only).
FILEGRID_ADMIN_PASSWORD=__GENERATE__
FILEGRID_DEMO_CLIENT_PASSWORD=__GENERATE__
FILEGRID_DEMO_EMPLOYEE_PASSWORD=__GENERATE__

# --- Host ports (always bound to 127.0.0.1) ------------------------------------
BACKEND_HOST_PORT=8080
KEYCLOAK_HOST_PORT=8180
# compose.dev.yaml only:
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
FTP_HOST_PORT=2121

# --- Entry point (reverse proxy) -------------------------------------------------
# Public address of FileGrid: API at /api/v1, login at /auth, Grafana at /grafana/.
# The TLS certificate is issued for this host name by the proxy's local CA.
FILEGRID_PUBLIC_URL=https://localhost:8443
# Host port of the proxy; must be the port used in FILEGRID_PUBLIC_URL.
PROXY_HOST_PORT=8443
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network.
PROXY_BIND=127.0.0.1
# Public deployment (docs/deploy.md): uncomment both for a real Let's Encrypt certificate,
# and set FILEGRID_PUBLIC_URL=https://<your domain>, PROXY_HOST_PORT=443, PROXY_BIND=0.0.0.0.
#COMPOSE_FILE=compose.yaml:compose.public.yaml
#FILEGRID_ACME_EMAIL=you@example.org

# --- Observability ---------------------------------------------------------------
# Grafana signs users in through Keycloak (realm role `admin` only) with this client secret.
GRAFANA_OAUTH_CLIENT_SECRET=__GENERATE__
# Secret of the Keycloak client the backend uses to create applicant logins on registration.
FILEGRID_KEYCLOAK_BACKEND_SECRET=__GENERATE__
# Grafana's built-in admin account; its login form is disabled, kept for API/break-glass use.
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# --- Meter simulator ------------------------------------------------------------
# Uses FILEGRID_METER_API_KEY from the backend section above.
