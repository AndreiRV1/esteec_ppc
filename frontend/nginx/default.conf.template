# Rendered at container start by the nginx image's envsubst step: only the
# ${UPPER_CASE} variables set in the environment are replaced, nginx's own
# $variables are left alone. Static files only: /api and /grafana are routed
# by the platform's reverse proxy / ingress, on the same origin.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime configuration for the app. Nothing here is secret.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"keycloakUrl":"${KEYCLOAK_URL}","realm":"${KEYCLOAK_REALM}","clientId":"${KEYCLOAK_CLIENT_ID}","grafanaUrl":"${GRAFANA_URL}","mock":${MOCK_API}}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Fingerprinted build output: cache for a year.
    location ~* \.(?:js|css|woff2?)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything else is the single-page app; index.html is never cached.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
