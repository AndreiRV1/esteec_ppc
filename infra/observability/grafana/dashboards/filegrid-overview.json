      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum (rate(http_server_requests_seconds_count{uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) / sum (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[$__rate_interval])) or vector(0)",
