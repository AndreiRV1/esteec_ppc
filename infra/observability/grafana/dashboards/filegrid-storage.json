          "expr": "sum by (category, backend, operation) (rate(filegrid_storage_operation_seconds_count{category=~\"$category\", backend=~\"$backend\"}[$__rate_interval]))",
          "legendFormat": "{{category}} / {{backend}} / {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
